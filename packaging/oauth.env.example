# Client OAuth padrão embutido no binário pelo install.sh.
# Copie para packaging/oauth.env (ignorado pelo git) e preencha.
# Com ele, "Conectar" funciona sem `omarchy-drive setup`.
OMARCHY_DRIVE_GOOGLE_CLIENT_ID=
# O secret de "App para computador" não é confidencial (RFC 8252), mas fica fora do git.
OMARCHY_DRIVE_GOOGLE_CLIENT_SECRET=
OMARCHY_DRIVE_MS_CLIENT_ID=
